+// A wisp of smoke as it is drawn: its middle in page px (the lean of its height taken in), its height off the ground, its size, its turn and its strength.
+export interface Wisp { x: number; y: number; z: number; size: number; turn: number; thick: number }
+
+// Where no smoke is drawn in the last moment: the box of the figure that walks to the button, in px round the spot it stands on, and the px beyond it over which a wisp comes back to its whole strength.
+export const WISP_CLEAR = { x0: -110, y0: -180, x1: 120, y1: 80, soft: 90 }
+
+// How much of a wisp is left beside the figure: none where its picture reaches the figure's box, all of it `soft` px away.
+export function wispShare(w: { x: number; y: number; size: number }, fig: { x: number; y: number } | null): number {
+  if (!fig) return 1
+  const dx = Math.max(fig.x + WISP_CLEAR.x0 - w.x, 0, w.x - (fig.x + WISP_CLEAR.x1))
+  const dy = Math.max(fig.y + WISP_CLEAR.y0 - w.y, 0, w.y - (fig.y + WISP_CLEAR.y1))
+  const k = clamp01((Math.hypot(dx, dy) - w.size * 0.95) / WISP_CLEAR.soft)
+  return k * k * (3 - 2 * k)
+}
