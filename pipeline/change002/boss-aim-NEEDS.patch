+
+describe('the lights of a picture are aimed from scratch', () => {
+  const frames = (rig: LightRig): number[] => [rig.key, rig.dome].flatMap((l) => {
+    const c = l.shadow.camera
+    return [c.left, c.right, c.top, c.bottom, c.near, c.far, l.shadow.bias]
+  })
+
+  it('gives the key and the fill the same shadow frames whatever was aimed before', () => {
+    const two = samples(2)
+    const eight = samples(8)
+    const fresh = new LightRig()
+    const used = new LightRig()
+    for (let i = 0; i < 48; i++) used.place(eight[i % 8]!)
+    for (const s of two) {
+      fresh.place(s)
+      used.place(s)
+      expect(frames(used)).toEqual(frames(fresh))
+    }
+  })
+})
